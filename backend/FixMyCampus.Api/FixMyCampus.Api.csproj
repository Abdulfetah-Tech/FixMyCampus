    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixMyCampus.Infrastructure\FixMyCampus.Infrastructure.csproj" />
